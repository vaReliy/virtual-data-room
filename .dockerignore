# The build context is the repository root: the Dockerfile needs the lockfile and every
# workspace package.json, so it cannot be narrowed to apps/api.
#
# Everything below is either rebuilt inside the image, useless to it, or must never enter
# it. Keep .env in that last group: a secret baked into a layer stays in the image even
# if a later layer deletes it, and this image is pushed to a registry.

.git
.github
node_modules
**/node_modules

# Rebuilt inside the image. Copying a host build in would make the image depend on
# whatever happened to be on the developer's machine.
**/dist
**/build
**/*.tsbuildinfo

# Generated by `prisma generate` during the build. A stale host copy would silently win.
apps/api/src/generated

# Never. See above.
.env
.env.*
!.env.example
*.pem
*-key.json

# Not part of the API image. `apps/web` is NOT excluded: `pnpm install --frozen-lockfile`
# reads every workspace manifest to rebuild the dependency graph, and a missing one makes
# it reject the lockfile as out of sync. Its sources are dropped in the runtime stage
# instead, which is where it actually matters.
docs
notes
docker-data
coverage
*.log
.vscode
.idea
.claude
