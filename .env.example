# Copy to `.env` and fill in. `.env` is gitignored; this file is committed and must
# never contain a real value. Every variable the app reads is documented here.

# --- Database (Neon in production, docker-compose Postgres locally) ---
# Pooled connection, used at runtime. On Neon the host contains "-pooler".
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Direct connection, used by `prisma migrate`. PgBouncer in transaction mode cannot
# carry the session-level statements migrations issue, so this must NOT be the pooled one.
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require

# Integration tests only, and read from the real environment rather than from `.env` —
# Vitest does not load this file. A database of its own, beside the compose one: the
# harness empties every table between tests, so pointing it at the development database
# would wipe the local sign-in on every run. `prisma migrate deploy` creates it on first
# use, and the value below is also the built-in default, so it can be left unset.
TEST_DATABASE_URL=postgresql://dataroom:dataroom@localhost:5432/dataroom_test

# --- Google OAuth ---
# Console: APIs & Services > Credentials > OAuth client ID (Web application).
# The redirect URI must match the client's registered URI exactly, scheme and port included.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# --- Object storage (S3-compatible: MinIO locally, GCS in production) ---
# GCS: https://storage.googleapis.com  |  MinIO: http://localhost:9000
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=europe-west3
STORAGE_BUCKET=
# GCS requires an HMAC key (Cloud Storage > Settings > Interoperability), not a
# service-account JSON key — the S3 XML API authenticates with an access key pair.
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# --- App ---
# Origin the browser sees. Both the SPA and /api/* live here (single-origin topology).
APP_URL=http://localhost:5173
# Signing key for the session cookie. Generate 32+ random bytes, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
# How many reverse proxies sit in front of the API process, for Express `trust proxy`.
# Read by one thing only: the per-IP rate limit on the anonymous share surface
# (/api/s/:token). It is a deployment fact, not a preference — too high and a caller can
# spoof X-Forwarded-For past the limit, too low and every caller shares one bucket.
# Leave it 0 locally: Vite's proxy adds no forwarding header. In Cloud Run behind the
# Vercel rewrite, set it to what the service actually observes — the API logs the first
# anonymous request's req.ip and raw X-Forwarded-For once per process for that purpose.
TRUST_PROXY_HOPS=0
