# Supply chain (decision #12): exact versions, and nothing younger than 7 days.
#
# These are the npm-format keys, kept for any tooling that reads `.npmrc`. pnpm 10+
# does NOT read them from here — the settings pnpm actually applies live in
# `pnpm-workspace.yaml` as `saveExact` and `minimumReleaseAge`. Change both together.
save-exact=true
minimum-release-age=10080
