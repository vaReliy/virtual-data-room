{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Browser target, so the Node libs the API relies on are deliberately absent.
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // Vite does the bundling, so TypeScript only type-checks. `preserve` leaves the
    // import syntax alone and implies bundler-style resolution.
    "module": "preserve",
    // The base config is nodenext for the API; the browser build resolves like a bundler.
    "moduleResolution": "bundler",
    "noEmit": true,
    "jsx": "react-jsx",
    // TS 6 no longer infers rootDir from `include` the way TS 5 did; every tsconfig in
    // this repo states it (see notes on the TypeScript pin).
    // The repository root, not `apps/web`: the program legitimately spans two packages now
    // that `@dr/contracts` is checked from source, and a `rootDir` under one of them makes
    // the other "not under rootDir" (TS6059). Nothing is emitted from here — `noEmit` is
    // on, Vite does the building — so `rootDir` only bounds what the checker will accept.
    "rootDir": "../..",
    "types": ["vite/client", "node"],
    // Mirrors the aliases in vite.config.ts, and the second one is not cosmetic: without
    // it TypeScript checks against `packages/contracts/dist/index.d.ts` while Vite bundles
    // `src`, so a stale `dist` would let the two disagree about what the contracts export.
    // Both must name the same file.
    "paths": {
      "@/*": ["./src/*"],
      "@dr/contracts": ["../../packages/contracts/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
